# Firebase Web SDK — nilai ini dapat dilihat di browser, bukan secret backend.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server saja — jangan beri awalan NEXT_PUBLIC_ dan jangan commit nilainya.
# API key Geoapify (https://myprojects.geoapify.com), paket Free tanpa kartu.
GEOAPIFY_API_KEY=
# Path absolut ke JSON service account Firebase, simpan di luar repo. Dipakai penghitung kuota di Firestore.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatif untuk hosting tanpa file (Vercel): isi penuh JSON service account dalam satu baris. Diutamakan bila diisi.
# FIREBASE_SERVICE_ACCOUNT=
# Opsional, untuk uji: menurunkan budget harian Geoapify (maks 2400).
# GEOAPIFY_DAILY_BUDGET=
# API key Gemini Developer API (https://aistudio.google.com/apikey), server saja. Free tier: data dapat dipakai Google, jadi pakai data uji.
GEMINI_API_KEY=
# Opsional: model utama (default gemini-3.5-flash-lite, kuota gemini_lite) dan cadangan (default gemini-3.8-flash, kuota gemini).
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODEL=
# Opsional, untuk uji: menurunkan batas request Gemini per hari (maks 200).
# GEMINI_DAILY_BUDGET=
